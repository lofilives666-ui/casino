generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  fullName        String
  email           String              @unique
  passwordHash    String
  balance         Decimal             @default(1000.00) @db.Decimal(12, 2)
  emailVerifiedAt DateTime?
  twoFactorEnabled Boolean            @default(false)
  kycStatus       String              @default("unverified")
  country         String?
  dob             DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  provablyFair    PlinkoProvablyFair?
  plinkoRounds    PlinkoRound[]
  verificationCodes EmailVerificationCode[]
  walletLedgers   WalletLedger[]
  walletTransactions WalletTransaction[]
  kycSubmissions  KycSubmission[]
}

model PlinkoProvablyFair {
  id             String   @id @default(cuid())
  userId         String   @unique
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlinkoRound {
  id             String   @id @default(cuid())
  userId         String
  risk           String
  rows           Int
  bet            Decimal  @db.Decimal(12, 2)
  multiplier     Decimal  @db.Decimal(12, 2)
  payout         Decimal  @db.Decimal(12, 2)
  balanceBefore  Decimal  @db.Decimal(12, 2)
  balanceAfter   Decimal  @db.Decimal(12, 2)
  resultIndex    Int
  nonce          Int
  serverSeedHash String
  clientSeed     String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model WalletLedger {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  reference String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  kind          String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  status        String
  method        String?
  provider      String?
  providerRef   String?
  requestedAt   DateTime @default(now())
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([provider, providerRef])
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([processedAt(sort: Desc)])
}

model KycSubmission {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("basic_submitted")
  legalName       String
  dob             DateTime
  country         String
  addressLine1    String
  city            String
  postalCode      String
  docType         String?
  idNumber        String?
  idFrontUrl      String?
  idBackUrl       String?
  selfieUrl       String?
  addressProofUrl String?
  reviewNotes     String?
  provider        String?
  providerCaseId  String?
  providerStatus  String?
  amlStatus       String?
  riskLevel       String?
  riskScore       Int?
  amlFlags        Json?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([provider, providerCaseId])
}

model KycProviderEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([processedAt(sort: Desc)])
}
